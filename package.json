{
  "name": "visc-line",
  "version": "0.1.0",
  "description": "Component functions to render line charts with D3.js",
  "type": "module",
  "scripts": {
    "start": "echo \"Hello world\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "tsdown:build": "tsdown",
    "front:build": "vite build",
    "dev": "vite",
    "test": "vitest"
  },
  "author": {
    "name": "José Martínez Santana"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetalbolicX/visc-line.git"
  },
  "bugs": {
    "url": "https://github.com/MetalbolicX/visc-line/issues"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "eslint": "^10.1.0",
    "eslint-plugin-jsdoc": "^62.8.1",
    "eslint-plugin-perfectionist": "^5.7.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "jsdom": "^29.0.1",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.umd.js",
  "exports": {
    "imports": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0"
  },
  "peerDependencies": {
    "d3": "^7.9.0"
  },
  "engines": {
    "node": ">20.0.0"
  }
}
