{
  "name": "visc-line",
  "version": "1.1.0",
  "description": "Component functions to render line charts with D3.js",
  "type": "module",
  "scripts": {
    "start": "echo \"Hello world\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "build": "tsdown",
    "dev": "vite",
    "test": "vitest run",
    "docs": "docsify serve docs",
    "check": "pnpm type-check && pnpm test && pnpm build && pnpm lint",
    "prepublishOnly": "pnpm type-check && pnpm test && pnpm build"
  },
  "author": {
    "name": "José Martínez Santana"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetalbolicX/visc-line.git"
  },
  "bugs": {
    "url": "https://github.com/MetalbolicX/visc-line/issues"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "d3",
    "d3.js",
    "chart",
    "line-chart",
    "line chart",
    "svg",
    "typescript",
    "data-visualization",
    "dataviz"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-immutable": "^1.0.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "jsdom": "^30.0.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.mts",
        "default": "./dist/internal.mjs"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    }
  },
  "dependencies": {
    "tipviz": "^3.0.1"
  },
  "peerDependencies": {
    "d3": "^7.9.0"
  },
  "engines": {
    "node": ">20.0.0"
  }
}
