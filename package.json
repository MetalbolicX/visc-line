{
  "name": "visc-line",
  "version": "1.0.0",
  "description": "Component functions to render line charts with D3.js",
  "type": "module",
  "scripts": {
    "start": "echo \"Hello world\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "build": "tsdown",
    "dev": "vite",
    "test": "vitest",
    "docs": "docsify serve docs",
    "prepublishOnly": "pnpm type-check && pnpm test && pnpm build"
  },
  "author": {
    "name": "José Martínez Santana"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetalbolicX/visc-line.git"
  },
  "bugs": {
    "url": "https://github.com/MetalbolicX/visc-line/issues"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "eslint": "^10.2.1",
    "eslint-plugin-functional": "^9.0.4",
    "eslint-plugin-immutable": "^1.0.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "jsdom": "^29.0.2",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {
    "tipviz": "^2.3.1"
  },
  "peerDependencies": {
    "d3": "^7.9.0",
    "tipviz": "^2.1.0"
  },
  "engines": {
    "node": ">20.0.0"
  }
}
